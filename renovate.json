{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "automerge": true,
  "automergeType": "branch",
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "jest-dom declares vitest as a peer and ships type augmentations for it, so both must be updated together",
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "@testing-library/jest-dom"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "vitest and jest-dom"
    }
  ]
}
